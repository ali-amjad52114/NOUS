{
  "components": [
    {
      "id": "webhook_1",
      "provider": "webhook",
      "config": {
        "hideForm": true,
        "mode": "Source",
        "parameters": {},
        "type": "webhook"
      },
      "ui": {
        "position": {
          "x": 20,
          "y": 160
        }
      }
    },
    {
      "id": "nous_protocol_1",
      "provider": "nous_protocol",
      "config": {
        "type": "nous_protocol",
        "callback_base": "http://127.0.0.1:7200",
        "protocol_id": "P-KEEPER",
        "trigger_class": "promise_made",
        "steps": [
          {
            "action": "book",
            "params": {
              "slot": "$slot",
              "with_person": "$person"
            }
          },
          {
            "action": "send_message",
            "params": {
              "to": "$person",
              "text": "$proposal"
            }
          }
        ],
        "postcondition": "calendar hold exists and message delivered"
      },
      "input": [
        {
          "lane": "text",
          "from": "webhook_1"
        }
      ],
      "ui": {
        "position": {
          "x": 240,
          "y": 160
        }
      }
    },
    {
      "id": "response_text_1",
      "provider": "response_text",
      "config": {
        "laneName": "result"
      },
      "input": [
        {
          "lane": "text",
          "from": "nous_protocol_1"
        }
      ],
      "ui": {
        "position": {
          "x": 460,
          "y": 160
        }
      }
    }
  ],
  "project_id": "a28ecdff-012c-5bc8-a8d0-777b8239b39b",
  "description": "Nous protocol P-KEEPER (promise_made)",
  "viewport": {
    "x": 0,
    "y": 0,
    "zoom": 1
  },
  "version": 1
}