{
  "components": [
    {
      "id": "webhook_1",
      "provider": "webhook",
      "config": {
        "hideForm": true,
        "mode": "Source",
        "parameters": {},
        "type": "webhook"
      },
      "ui": { "position": { "x": 20, "y": 200 } }
    },
    {
      "id": "guardrails_1",
      "provider": "guardrails",
      "config": {
        "profile": "custom",
        "custom": {
          "policy_mode": "block",
          "enable_prompt_injection": true,
          "enable_content_safety": true,
          "enable_pii_detection": false,
          "enable_hallucination_check": false,
          "max_input_length": 8000,
          "max_tokens_estimate": 3000,
          "expected_format": "json",
          "blocked_topics": [],
          "allowed_topics": ["commitment_id", "approved", "channel", "to", "text", "correlation_id"]
        }
      },
      "input": [{ "lane": "questions", "from": "webhook_1" }],
      "ui": { "position": { "x": 200, "y": 200 } }
    },
    {
      "id": "agent_rocketride_1",
      "provider": "agent_rocketride",
      "config": {
        "agent_description": "Nous send-message: approved Gmail/Slack send via Guild writers → LaserData + FalkorDB receipt. Never books calendar.",
        "instructions": [
          "Input MUST include {commitment_id, approved:true, channel:gmail|slack, to, text} plus optional correlation_id. Never create calendar events.",
          "1) If approved is not exactly true, send nothing and return {\"status\":\"rejected\",\"reason\":\"not_approved\",\"channel\":...,\"commitment_id\":...,\"correlation_id\":...}.",
          "2) Load commitment from FalkorDB personal_brain by commitment_id. Reject if missing.",
          "3) channel must be exactly \"gmail\" or \"slack\". Reject otherwise.",
          "4) If a successful send Receipt already exists for this commitment+channel+text fingerprint, return status=sent with that receipt (idempotent) without sending again.",
          "5) If channel=gmail: call tool_guild_gmail (nous-gmail-writer) with {correlation_id, commitment_id, to, text, subject?} — send only.",
          "6) If channel=slack: call tool_guild_slack (nous-slack-writer) with {correlation_id, commitment_id, to, text} — post only.",
          "7) On provider failure: publish failure to LaserData nous:receipts; write failure Receipt in FalkorDB; return {\"status\":\"failed\",\"channel\":...,\"correlation_id\":...,\"commitment_id\":...}. Never fabricate external_id.",
          "8) On success: publish to LaserData nous:receipts; write (:Action)-[:PRODUCED]->(:Receipt) with real provider id if any, executed_at, channel; return {\"status\":\"sent\",\"channel\":...,\"correlation_id\":...,\"commitment_id\":...}."
        ],
        "max_waves": 12,
        "parameters": {}
      },
      "input": [{ "lane": "questions", "from": "guardrails_1" }],
      "ui": { "position": { "x": 420, "y": 200 } }
    },
    {
      "id": "llm_openai_1",
      "provider": "llm_openai",
      "config": {
        "profile": "openai-4o-mini",
        "openai-4o-mini": { "apikey": "${ROCKETRIDE_OPENAI_KEY}" },
        "parameters": {}
      },
      "control": [
        { "classType": "llm", "from": "agent_rocketride_1" },
        { "classType": "llm", "from": "graph_falkordb_1" }
      ],
      "ui": { "position": { "x": 420, "y": 20 } }
    },
    {
      "id": "memory_internal_1",
      "provider": "memory_internal",
      "config": { "type": "memory_internal" },
      "control": [{ "classType": "memory", "from": "agent_rocketride_1" }],
      "ui": { "position": { "x": 420, "y": 380 } }
    },
    {
      "id": "graph_falkordb_1",
      "provider": "graph_falkordb",
      "config": {
        "type": "graph_falkordb",
        "host": "${FALKOR_HOST}",
        "port": 6379,
        "username": "${FALKOR_USERNAME}",
        "password": "${FALKOR_PASSWORD}",
        "tls": false,
        "graph": "personal_brain",
        "db_description": "Nous personal brain trust store for commitments and send-message receipts.",
        "allow_writes": true,
        "allow_execute": true,
        "max_attempts": 5,
        "max_rows": 250,
        "max_execute_rows": 25000,
        "query_timeout_ms": 30000
      },
      "control": [{ "classType": "tool", "from": "agent_rocketride_1" }],
      "ui": { "position": { "x": 660, "y": 20 } }
    },
    {
      "id": "tool_guild_gmail_1",
      "provider": "tool_guild",
      "config": {
        "type": "tool_guild",
        "baseUrl": "https://app.guild.ai",
        "apiKeyId": "${GUILD_API_KEY_ID}",
        "apiKeySecret": "${GUILD_API_KEY_SECRET}",
        "owner": "${GUILD_WORKSPACE_OWNER}",
        "workspace": "${GUILD_WORKSPACE_NAME}",
        "agent": "nous-gmail-writer",
        "resultMode": "wait",
        "timeout": 300,
        "maxSessions": 3,
        "verifyTls": true
      },
      "control": [{ "classType": "tool", "from": "agent_rocketride_1" }],
      "ui": { "position": { "x": 660, "y": 160 } }
    },
    {
      "id": "tool_guild_slack_1",
      "provider": "tool_guild",
      "config": {
        "type": "tool_guild",
        "baseUrl": "https://app.guild.ai",
        "apiKeyId": "${GUILD_API_KEY_ID}",
        "apiKeySecret": "${GUILD_API_KEY_SECRET}",
        "owner": "${GUILD_WORKSPACE_OWNER}",
        "workspace": "${GUILD_WORKSPACE_NAME}",
        "agent": "nous-slack-writer",
        "resultMode": "wait",
        "timeout": 300,
        "maxSessions": 3,
        "verifyTls": true
      },
      "control": [{ "classType": "tool", "from": "agent_rocketride_1" }],
      "ui": { "position": { "x": 660, "y": 300 } }
    },
    {
      "id": "tool_laserdata_memory_1",
      "provider": "tool_laserdata_memory",
      "config": {
        "type": "tool_laserdata_memory",
        "profile": "cloud",
        "cloud": {
          "connection_string": "${LASER_CONNECTION_STRING}",
          "namespace": "nous:receipts",
          "show_advanced": true,
          "stream": "nous",
          "allow_namespace_override": true,
          "folded": true,
          "recall_limit": 20,
          "op_timeout": 30
        }
      },
      "control": [{ "classType": "tool", "from": "agent_rocketride_1" }],
      "ui": { "position": { "x": 660, "y": 440 } }
    },
    {
      "id": "response_answers_1",
      "provider": "response_answers",
      "config": { "laneName": "result" },
      "input": [{ "lane": "answers", "from": "agent_rocketride_1" }],
      "ui": { "position": { "x": 900, "y": 200 } }
    }
  ],
  "description": "Approved send → Guild Gmail/Slack writer → LaserData + FalkorDB receipt (never books calendar)",
  "project_id": "9fae0ab5-906f-4390-a09b-a117375863f8",
  "viewport": { "x": 0, "y": 0, "zoom": 1 },
  "version": 1
}
