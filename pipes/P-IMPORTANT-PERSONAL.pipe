{
  "components": [
    {
      "id": "webhook_1",
      "provider": "webhook",
      "config": {
        "hideForm": true,
        "mode": "Source",
        "parameters": {},
        "type": "webhook"
      },
      "ui": { "position": { "x": 20, "y": 200 } }
    },
    {
      "id": "guardrails_1",
      "provider": "guardrails",
      "config": {
        "profile": "strict",
        "strict": {
          "policy_mode": "block",
          "max_tokens_estimate": 6000,
          "expected_format": "json"
        }
      },
      "input": [{ "lane": "questions", "from": "webhook_1" }],
      "ui": { "position": { "x": 200, "y": 200 } }
    },
    {
      "id": "agent_rocketride_1",
      "provider": "agent_rocketride",
      "config": {
        "agent_description": "Nous important_personal: soft Commitment stub requiring approval. No auto book/send.",
        "instructions": [
          "You record important personal context as a soft Commitment stub. Never auto-book. Never send messages. Never create calendar events.",
          "Input: event with trigger_class important_personal (e.g. Sam moving / life news), correlation_id, event_id.",
          "1) Extract person and short context sentence from the event.",
          "2) Write FalkorDB: MERGE Event, Contact, Commitment with status='awaiting_approval', requires_approval=true, soft=true. Edges: DETECTED_IN, PROMISED_TO. Do not create Action with calendar writer.",
          "3) Remember stub via tool_laserdata_memory namespace nous:life-events.",
          "4) Return JSON only: {\"status\":\"awaiting_approval\",\"commitment\":{\"id\":\"C-...\",\"person\":\"...\",\"context\":\"...\",\"requires_approval\":true,\"soft\":true},\"correlation_id\":\"...\",\"event_id\":\"...\"}."
        ],
        "max_waves": 8,
        "parameters": {}
      },
      "input": [{ "lane": "questions", "from": "guardrails_1" }],
      "ui": { "position": { "x": 420, "y": 200 } }
    },
    {
      "id": "llm_openai_1",
      "provider": "llm_openai",
      "config": {
        "profile": "openai-4o-mini",
        "openai-4o-mini": { "apikey": "${ROCKETRIDE_OPENAI_KEY}" },
        "parameters": {}
      },
      "control": [
        { "classType": "llm", "from": "agent_rocketride_1" },
        { "classType": "llm", "from": "graph_falkordb_1" }
      ],
      "ui": { "position": { "x": 420, "y": 20 } }
    },
    {
      "id": "memory_internal_1",
      "provider": "memory_internal",
      "config": { "type": "memory_internal" },
      "control": [{ "classType": "memory", "from": "agent_rocketride_1" }],
      "ui": { "position": { "x": 420, "y": 380 } }
    },
    {
      "id": "graph_falkordb_1",
      "provider": "graph_falkordb",
      "config": {
        "type": "graph_falkordb",
        "host": "${FALKOR_HOST}",
        "port": 6379,
        "username": "${FALKOR_USERNAME}",
        "password": "${FALKOR_PASSWORD}",
        "tls": false,
        "graph": "personal_brain",
        "db_description": "Soft Commitment stubs for important_personal; awaiting_approval only.",
        "allow_writes": true,
        "allow_execute": true,
        "max_attempts": 5,
        "max_rows": 250,
        "max_execute_rows": 25000,
        "query_timeout_ms": 30000
      },
      "control": [{ "classType": "tool", "from": "agent_rocketride_1" }],
      "ui": { "position": { "x": 660, "y": 120 } }
    },
    {
      "id": "tool_laserdata_memory_1",
      "provider": "tool_laserdata_memory",
      "config": {
        "type": "tool_laserdata_memory",
        "profile": "cloud",
        "cloud": {
          "connection_string": "${LASER_CONNECTION_STRING}",
          "namespace": "nous:life-events",
          "show_advanced": true,
          "stream": "nous",
          "allow_namespace_override": false,
          "folded": true,
          "recall_limit": 20,
          "op_timeout": 30
        }
      },
      "control": [{ "classType": "tool", "from": "agent_rocketride_1" }],
      "ui": { "position": { "x": 660, "y": 300 } }
    },
    {
      "id": "response_answers_1",
      "provider": "response_answers",
      "config": { "laneName": "result" },
      "input": [{ "lane": "answers", "from": "agent_rocketride_1" }],
      "ui": { "position": { "x": 900, "y": 200 } }
    }
  ],
  "description": "important_personal → soft Commitment stub awaiting_approval (no auto book/send)",
  "project_id": "a11c0d15-7110-4b2e-9f01-d15a71000007",
  "viewport": { "x": 0, "y": 0, "zoom": 1 },
  "version": 1
}
