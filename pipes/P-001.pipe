{
  "components": [
    {
      "id": "webhook_1",
      "provider": "webhook",
      "config": {
        "hideForm": true,
        "mode": "Source",
        "parameters": {},
        "type": "webhook"
      },
      "ui": { "position": { "x": 20, "y": 160 } }
    },
    {
      "id": "nous_protocol_1",
      "provider": "nous_protocol",
      "config": {
        "type": "nous_protocol",
        "callback_base": "${NOUS_CALLBACK_BASE}",
        "protocol_id": "P-001",
        "trigger_class": "incoming_invoice",
        "steps": [
          {
            "action": "forward",
            "params": { "to": "$to" }
          },
          {
            "action": "label",
            "params": { "name": "invoices" }
          },
          {
            "action": "archive",
            "params": {}
          }
        ],
        "postcondition": "{\"checks\":[{\"kind\":\"receipt_exists\",\"action\":\"forward\"},{\"kind\":\"receipt_exists\",\"action\":\"label\"},{\"kind\":\"receipt_exists\",\"action\":\"archive\"}]}"
      },
      "input": [{ "lane": "text", "from": "webhook_1" }],
      "ui": { "position": { "x": 240, "y": 160 } }
    },
    {
      "id": "response_text_1",
      "provider": "response_text",
      "config": { "laneName": "result" },
      "input": [{ "lane": "text", "from": "nous_protocol_1" }],
      "ui": { "position": { "x": 460, "y": 160 } }
    }
  ],
  "description": "Nous protocol P-001 incoming_invoice: forward → label(invoices) → archive (parameterized to)",
  "project_id": "62d95053-1710-5e7a-910e-63626d8cbaf8",
  "viewport": { "x": 0, "y": 0, "zoom": 1 },
  "version": 1
}
