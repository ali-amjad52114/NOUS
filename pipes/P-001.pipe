    {
      "id": "nous_protocol_1",
      "provider": "nous_protocol",
      "config": {
        "type": "nous_protocol",
        "callback_base": "http://127.0.0.1:7200",
        "protocol_id": "P-001",
        "trigger_class": "incoming_invoice",
        "steps": [
          {
            "action": "forward",
            "params": {
              "to": "accounting@myfirm.com"
            }
          },
          {
            "action": "label",
            "params": {
              "name": "invoices"
            }
          },
          {
            "action": "archive",
            "params": {}
          }
        ],
        "postcondition": "{\"checks\":[{\"action\":\"forward\",\"kind\":\"receipt_exists\"},{\"action\":\"label\",\"kind\":\"receipt_exists\"},{\"action\":\"archive\",\"kind\":\"receipt_exists\"}]}"
      },
      "input": [
        {
          "lane": "text",
          "from": "webhook_1"
        }
      ],
      "ui": {
        "position": {
          "x": 240,
          "y": 160
        }
      }
    },
    {
      "id": "response_text_1",
      "provider": "response_text",
      "config": {
        "laneName": "result"
      },
      "input": [
        {
          "lane": "text",
          "from": "nous_protocol_1"
        }
      ],
      "ui": {
        "position": {
          "x": 460,
          "y": 160
        }
      }
    }
